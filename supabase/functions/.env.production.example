# Set these with `supabase secrets set`; never deploy this file as-is.
LINE_CHANNEL_ID=replace-with-production-line-login-channel-id
ALLOWED_ORIGINS=https://app.example.com

# Central CSMS LINE OA Messaging API. Set with `supabase secrets set`, never in Tenant settings.
LINE_MESSAGING_OA_BASIC_ID=replace-with-central-oa-basic-id
LINE_MESSAGING_CHANNEL_ID=replace-with-central-oa-messaging-channel-id
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=replace-with-central-oa-channel-access-token
LINE_MESSAGING_CHANNEL_SECRET=replace-with-central-oa-channel-secret
LINE_DELIVERY_ENABLED=false
LINE_DELIVERY_CANARY_CHURCH_IDS=
LINE_DELIVERY_APP_BASE_URL=https://app.example.com/

# Stage E scheduled notification creation. Run both protected functions hourly.
# Days and local hours are configured by each Tenant's Root OU Admin.
NOTIFICATION_SCHEDULE_ENABLED=false
NOTIFICATION_SCHEDULE_CANARY_CHURCH_IDS=
