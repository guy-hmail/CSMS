{
  "name": "csms-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "liff:serve": "node --env-file=.env scripts/start-liff-proxy.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:auth": "tsx scripts/invite-token.test.ts",
    "test:liff-config": "tsx scripts/liff-config.test.ts",
    "test:integration": "tsx scripts/frontend-backend.integration.ts",
    "test:full-loop": "tsx scripts/full-loop.integration.ts",
    "test:edge": "deno test --allow-env supabase/functions/_shared/shared_test.ts",
    "preflight:production": "npm run check && npm run test:auth && npm run build && npm audit --omit=dev --audit-level=high",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "test:db": "supabase test db"
  },
  "devDependencies": {
    "@line/liff-cli": "^0.4.2",
    "@lucide/svelte": "^1.23.0",
    "@skeletonlabs/skeleton": "^4.13.0",
    "@skeletonlabs/skeleton-svelte": "^4.13.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "supabase": "^2.109.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@line/liff": "^2.29.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "pdf-lib": "^1.17.1",
    "write-excel-file": "^4.1.1"
  },
  "overrides": {
    "tmp": "^0.2.6"
  }
}
